# ==========================================
# Hermes Job AI - Configurações de Ambiente
# ==========================================

# Sua Chave da API do Gemini (Google AI Studio)
GEMINI_API_KEY=sua_chave_aqui

# Modelos recomendados para otimizar qualidade e cotas da sua conta
# Para triagem rápida de 500 vagas/dia com custo quase zero:
GEMINI_MODEL_FAST=gemini-2.5-flash

# Para quebrar filtros de ATS e responder dissertações difíceis no método STAR:
GEMINI_MODEL_SMART=gemini-2.5-pro

# Porta do Painel de Controle Web HTTP
PORT=8088
HOST=0.0.0.0

# Modo de Operação:
# "review" = Recomenda as vagas no painel e você aprova com 1 clique antes do envio
# "auto"   = Envia automaticamente quando o Score ATS for maior que o mínimo configurado
OPERATION_MODE=review
MIN_AUTO_APPLY_SCORE=85

# Agendador 24/7 (em horas)
INTERVAL_SCAN_HOURS=2.0
PAUSE_NIGHT=true

# Notificações no Telegram (Opcional - deixe vazio se não for usar)
# Crie um bot no @BotFather para pegar o token e pegue seu id no @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
